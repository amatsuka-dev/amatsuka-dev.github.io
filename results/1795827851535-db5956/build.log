--- build.gradle ---
plugins {
    id 'fabric-loom' version '1.9-SNAPSHOT'
    id 'maven-publish'
}

version = project.mod_version
group = project.maven_group

base { archivesName = project.archives_base_name }

def withVoice = project.withVoice.toBoolean()
def withVideo = project.withVideo.toBoolean()

repositories {
    mavenCentral()
    maven { name = 'MaxHenkel'; url = 'https://maven.maxhenkel.de/repository/public' }
}

dependencies {
    minecraft "com.mojang:minecraft:${project.minecraft_version}"
    mappings "net.fabricmc:yarn:${project.yarn_mappings}:v2"
    modImplementation "net.fabricmc:fabric-loader:${project.loader_version}"
    modImplementation "net.fabricmc.fabric-api:fabric-api:${project.fabric_version}"

    // Simple Voice Chat (API de plugins): solo para compilar; el mod real es opcional en runtime
    if (withVoice) modCompileOnly "de.maxhenkel.voicechat:voicechat-api:${project.voicechat_api_version}"

    // JCodec (mp4/H.264 en Java puro) para fondos de video; va empaquetado dentro del jar
    if (withVideo) {
        implementation "org.jcodec:jcodec:${project.jcodec_version}"
        implementation "org.jcodec:jcodec-javase:${project.jcodec_version}"
        include "org.jcodec:jcodec:${project.jcodec_version}"
        include "org.jcodec:jcodec-javase:${project.jcodec_version}"
    }
}

sourceSets.main.java {
    if (!withVoice) exclude 'com/morphzuka/compat/**'
    if (!withVideo) exclude 'com/morphzuka/ui/VideoDecoder.java'
}

processResources {
    inputs.property "version", project.version
    filesMatching("fabric.mod.json") { expand "version": project.version }
}

tasks.withType(JavaCompile).configureEach { it.options.release = 21; it.options.encoding = 'UTF-8' }

java {
    withSourcesJar()
    sourceCompatibility = JavaVersion.VERSION_21
    targetCompatibility = JavaVersion.VERSION_21
}
